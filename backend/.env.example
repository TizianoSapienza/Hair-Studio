# Server
PORT=4000
NODE_ENV=development

# Frontend origin allowed to call the API with credentials
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgres://hairstudio:hairstudio@localhost:5432/hairstudio

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# bcrypt
BCRYPT_COST=12

# Admin seed (used only by `npm run seed:admin`)
SEED_ADMIN_EMAIL=admin@hairstudio.it
SEED_ADMIN_PASSWORD=change-me-strong-password
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Hair Studio
SEED_ADMIN_PHONE=+390000000000

# Resend (email) - to be filled when integration is wired up
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Firebase Cloud Messaging (push) - to be filled when integration is wired up
FCM_SERVICE_ACCOUNT_JSON=
